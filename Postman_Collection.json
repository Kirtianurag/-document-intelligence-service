{
  "info": {
    "_postman_id": "8f2a9e1d-4b72-4f3a-912c-0e8d6f51a2bc",
    "name": "Document Intelligence & Question Extraction Service",
    "description": "Postman API workflow collection for Pragati Bharati Full Stack Developer Assignment Round 2.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@pragatibharati.edu\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Login & Obtain Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"bearer_token\", jsonData.access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "user@pragatibharati.edu"
                },
                {
                  "key": "password",
                  "value": "SecurePass123!"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/token",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "token"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Document Management",
      "item": [
        {
          "name": "Upload Clean PDF Document",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"document_id\", jsonData.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "sample_data/sample_1_clean.pdf"
                },
                {
                  "key": "document_type",
                  "value": "QUESTION_PAPER",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/documents/upload",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "documents", "upload"]
            }
          }
        },
        {
          "name": "List User Documents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/documents/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "documents", ""]
            }
          }
        },
        {
          "name": "Get Document Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/documents/{{document_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "documents", "{{document_id}}"]
            }
          }
        },
        {
          "name": "Get Document Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/documents/{{document_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "documents", "{{document_id}}", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Question Extraction & Details",
      "item": [
        {
          "name": "Get Extracted Questions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/documents/{{document_id}}/questions",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "documents", "{{document_id}}", "questions"]
            }
          }
        },
        {
          "name": "Get Answer Key Information",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/documents/{{document_id}}/answers",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "documents", "{{document_id}}", "answers"]
            }
          }
        },
        {
          "name": "Get Review Items & Warnings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/documents/{{document_id}}/review-items",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "documents", "{{document_id}}", "review-items"]
            }
          }
        },
        {
          "name": "Export Final Structured Output JSON",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/documents/{{document_id}}/export",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "documents", "{{document_id}}", "export"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "bearer_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "document_id",
      "value": "",
      "type": "string"
    }
  ]
}
