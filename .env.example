# API Configuration
PROJECT_NAME="Document Intelligence & Question Extraction Service"
API_V1_STR="/api/v1"
SECRET_KEY="CHANGE_THIS_TO_YOUR_SECURE_SECRET_KEY"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_DB=doc_intelligence

# Database Connection URL (Async / Sync)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/doc_intelligence
# ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/doc_intelligence

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Storage Settings
UPLOAD_DIR=storage/uploads
MAX_FILE_SIZE_MB=50

# Optional AI / OCR Services Configuration
GEMINI_API_KEY=
OPENAI_API_KEY=
ENABLE_AI_FALLBACK=true
